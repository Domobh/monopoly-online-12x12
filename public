<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Monopoly 12×12 Online — Full</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#0b1020;color:#edf2ff;font-family:Inter,Arial,sans-serif}.app{max-width:1450px;margin:auto;padding:18px}h1{margin:0 0 4px}.sub{color:#9eabc7;margin-bottom:16px}
.panel{background:#141c2e;border:1px solid #293651;border-radius:16px;padding:14px;box-shadow:0 12px 35px #0005}.lobby{max-width:720px;margin:60px auto}.row{display:flex;gap:8px;flex-wrap:wrap}.field{display:flex;flex-direction:column;gap:5px;margin-bottom:10px;flex:1}.field label,.muted{font-size:12px;color:#98a6c3}input,select{background:#0a1020;color:#fff;border:1px solid #35435f;border-radius:9px;padding:11px}button{border:0;border-radius:9px;padding:10px 13px;background:#2563eb;color:#fff;font-weight:800;cursor:pointer}button:disabled{opacity:.4;cursor:not-allowed}.green{background:#16a34a}.red{background:#dc2626}.gray{background:#475569}.status{background:#0a1020;padding:10px;border-radius:10px;margin:9px 0;color:#cbd5e1}.game{display:grid;grid-template-columns:350px 1fr;gap:16px}.code{font-size:28px;font-weight:900;letter-spacing:5px;text-align:center;background:#0a1020;border:1px dashed #53627e;padding:10px;border-radius:10px}.players{display:flex;flex-direction:column;gap:6px;margin:8px 0 12px}.pl{display:flex;align-items:center;gap:7px;padding:8px;background:#0a1020;border-radius:8px}.dot{width:12px;height:12px;border-radius:50%}.actions{display:flex;gap:7px;flex-wrap:wrap;margin:8px 0}.dice{display:flex;justify-content:center;gap:10px;margin:10px}.die{width:54px;height:54px;border-radius:11px;background:#fff;color:#111;display:grid;place-items:center;font-size:30px;box-shadow:0 5px 15px #0006}.rollanim{animation:roll .12s infinite linear}.land{animation:land .35s}.log{max-height:180px;overflow:auto;background:#090f1c;border-radius:9px;padding:9px;font-size:12px;line-height:1.45}
.boardwrap{overflow:auto}.board{width:min(78vw,850px);height:min(78vw,850px);min-width:620px;min-height:620px;display:grid;grid-template-columns:repeat(12,1fr);grid-template-rows:repeat(12,1fr);gap:2px;background:#3b465f;padding:3px;border-radius:15px;margin:auto}.cell{position:relative;background:#edf1f7;color:#111;border-radius:4px;overflow:hidden;text-align:center;font-size:9px;padding:3px}.cell.special{background:#d5ddea}.bar{height:7px;margin:-3px -3px 3px;background:#778399}.name{font-weight:900;line-height:1.05}.price{font-size:8px}.owner{position:absolute;bottom:3px;left:3px;width:9px;height:9px;border-radius:50%}.tokens{position:absolute;bottom:2px;right:2px;display:flex;gap:2px}.token{width:15px;height:15px;border:2px solid #fff;border-radius:50%;box-shadow:0 1px 4px #000}.center{grid-column:3/11;grid-row:3/11;background:#11192a;border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}.modal{position:fixed;inset:0;background:#0009;display:flex;align-items:center;justify-content:center;padding:20px;z-index:10}.modalbox{width:min(520px,100%);background:#182238;border:1px solid #35435f;border-radius:15px;padding:18px}.hide{display:none!important}.tradegrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.small{font-size:12px}@keyframes roll{0%{transform:rotate(-8deg) scale(.9)}50%{transform:rotate(8deg) scale(1.12)}100%{transform:rotate(-8deg) scale(.9)}}@keyframes land{0%{transform:scale(1.25)}70%{transform:scale(.92)}100%{transform:scale(1)}}@media(max-width:1000px){.game{grid-template-columns:1fr}.board{margin:auto}}
</style></head><body><div class="app">
<h1>🎲 Monopoly 12×12 Online — Full</h1><div class="sub">Комнаты, аукцион, торговля, дома, залог, тюрьма и синхронизация через сервер.</div>
<section id="lobby" class="panel lobby"><div class="row"><div class="field"><label>Имя</label><input id="name" maxlength="18" placeholder="Данил"></div><div class="field" style="max-width:160px"><label>Игроков</label><select id="max"><option>2</option><option>3</option><option selected>4</option></select></div></div>
<div class="actions"><button id="create">Создать комнату</button><input id="joincode" maxlength="6" placeholder="КОД" style="width:110px;text-transform:uppercase"><button id="join" class="green">Войти</button></div><div id="lmsg" class="status">Подключение…</div></section>
<section id="game" class="game hide"><aside class="panel"><div class="muted">Код комнаты</div><div id="code" class="code">------</div>
<div class="actions"><button id="copy">Скопировать</button><button id="leave" class="gray">Выйти</button></div><div id="status" class="status"></div>
<h3>Игроки</h3><div id="players" class="players"></div><div class="dice"><div id="d1" class="die">⚀</div><div id="d2" class="die">⚀</div></div>
<div class="actions"><button id="roll">🎲 Бросить</button><button id="buy" class="green" disabled>Купить</button><button id="auction" disabled>Аукцион</button><button id="build" disabled>🏠 Построить</button><button id="sell" disabled>Продать дом</button><button id="mort" disabled>Заложить</button><button id="unmort" disabled>Выкупить</button><button id="end" class="gray" disabled>Закончить ход</button></div>
<div id="host" class="actions hide"><button id="start" class="green">Начать игру</button></div><button id="trade" class="gray">🤝 Предложить обмен</button>
<h3>Журнал</h3><div id="log" class="log"></div></aside><main class="panel boardwrap"><div id="board" class="board"></div></main></section></div>
<div id="modal" class="modal hide"><div class="modalbox"><h2 id="mtitle"></h2><div id="mbody"></div><div class="actions" id="mact"></div></div></div>
<script src="/socket.io/socket.io.js"></script><script>
const socket=io();let state=null,myId=null,isHost=false,anim=false;const faces=["⚀","⚁","⚂","⚃","⚄","⚅"],$=x=>document.getElementById(x);
socket.on("connect",()=>msg("Сервер подключён."));socket.on("disconnect",()=>msg("Соединение потеряно.",true));
socket.on("errorMsg",x=>{msg(x,true);alert(x)});socket.on("joined",x=>{isHost=x.host;myId=socket.id;$("lobby").classList.add("hide");$("game").classList.remove("hide");$("code").textContent=x.code});
socket.on("state",s=>{const old=state?.lastRoll;state=s;render();if(old&&JSON.stringify(old)!==JSON.stringify(s.lastRoll))dice(s.lastRoll);if(s.trade&&s.trade.toId===myId)tradeModal(true);else if(s.auction)auctionModal();else if(s.pending&&s.pending.playerId===myId)buyModal()});
function msg(t,b=false){$("lmsg").textContent=t;$("lmsg").style.color=b?"#fecaca":"#cbd5e1"}
$("create").onclick=()=>socket.emit("createRoom",{name:$("name").value.trim()||"Игрок",maxPlayers:+$("max").value});
$("join").onclick=()=>socket.emit("joinRoom",{name:$("name").value.trim()||"Игрок",code:$("joincode").value.trim().toUpperCase()});
$("start").onclick=()=>socket.emit("startGame");$("roll").onclick=()=>{if(!anim)socket.emit("roll")};$("buy").onclick=()=>socket.emit("buy");$("auction").onclick=()=>socket.emit("auction");$("build").onclick=()=>socket.emit("build");$("sell").onclick=()=>socket.emit("sellHouse");$("mort").onclick=()=>socket.emit("mortgage");$("unmort").onclick=()=>socket.emit("unmortgage");$("end").onclick=()=>socket.emit("endTurn");$("leave").onclick=()=>location.reload();
$("copy").onclick=async()=>{try{await navigator.clipboard.writeText(location.href+"?room="+state.code+"\\nКод: "+state.code);alert("Ссылка и код скопированы")}catch{alert(state.code)}};
$("trade").onclick=()=>tradeModal(false);
function dice(r){anim=true;[$("d1"),$("d2")].forEach(x=>x.classList.add("rollanim"));let n=0,t=setInterval(()=>{[$("d1"),$("d2")].forEach(x=>x.textContent=faces[Math.floor(Math.random()*6)]);if(++n>12){clearInterval(t);$("d1").textContent=faces[r[0]-1];$("d2").textContent=faces[r[1]-1];[$("d1"),$("d2")].forEach(x=>{x.classList.remove("rollanim");x.classList.add("land")});setTimeout(()=>{[$("d1"),$("d2")].forEach(x=>x.classList.remove("land"));anim=false},400)}},85)}
function me(){return state?.players.find(p=>p.id===myId)}function mi(){return state?.players.findIndex(p=>p.id===myId)}
function render(){if(!state)return;const p=me(),c=p&&state.board[p.pos];$("code").textContent=state.code;$("status").textContent=state.message||"—";$("host").classList.toggle("hide",!isHost||state.started);$("start").disabled=state.players.length<2;
$("roll").disabled=!state.started||state.turn!==mi()||anim||!!state.pending||!!state.auction||!!state.trade;$("end").disabled=!state.started||state.turn!==mi()||!!state.pending||!!state.auction||!!state.trade;
$("buy").disabled=!state.pending||state.pending.playerId!==myId;$("auction").disabled=!state.pending||state.pending.playerId!==myId;
$("build").disabled=!p||state.turn!==mi()||!c||c.owner!==myId||c.type!=="property"||c.houses>=5||p.money<Math.max(50,Math.round(c.price*.5));
$("sell").disabled=!p||state.turn!==mi()||!c||c.owner!==myId||c.houses<=0;$("mort").disabled=!p||state.turn!==mi()||!c||c.owner!==myId||c.houses>0||c.mortgaged;$("unmort").disabled=!p||state.turn!==mi()||!c||c.owner!==myId||!c.mortgaged;
$("players").innerHTML=state.players.map((x,i)=>`<div class="pl"><span class="dot" style="background:${x.color}"></span><b>${esc(x.name)}</b><span style="margin-left:auto">$${x.money}</span>${!x.connected?" 🔌":""}${x.bankrupt?" 💀":state.started&&state.turn===i?" 🎯":""}</div>`).join("");
$("log").innerHTML=state.logs.map(x=>`<div>${esc(x)}</div>`).join("");board();if(state.winner){alert("Победитель: "+(state.players.find(x=>x.id===state.winner)?.name||"—"))}}
function board(){const b=$("board");b.innerHTML="";const per=[];for(let c=0;c<12;c++)per.push([11,c]);for(let r=10;r>=0;r--)per.push([r,11]);for(let c=10;c>=0;c--)per.push([0,c]);for(let r=1;r<11;r++)per.push([r,0]);const map=Array(144).fill(null);per.forEach((xy,i)=>map[xy[0]*12+xy[1]]=i);
for(let i=0;i<144;i++){let e=document.createElement("div"),pos=map[i];if(pos===null){if(i===78){e.className="center";e.innerHTML="<h2>MONOPOLY</h2><div>12×12 ONLINE</div><div class='muted'>"+state.code+"</div>"}else e.style.background="transparent";b.appendChild(e);continue}
const c=state.board[pos];e.className="cell "+(c.type==="special"||c.type==="jail"||c.type==="free"?"special":"");e.innerHTML=`<div class="bar"></div><div class="name">${esc(c.name)}</div>${c.price?`<div class="price">$${c.price}</div>`:""}${c.houses?`<div>🏠 ${c.houses>=5?"🏨":c.houses}</div>`:""}${c.mortgaged?"<div>💤</div>":""}${c.owner?`<span class="owner" style="background:${ocol(c.owner)}"></span>`:""}<div class="tokens"></div>`;const ts=e.querySelector(".tokens");state.players.forEach(p=>{if(p.pos===pos&&!p.bankrupt){let t=document.createElement("span");t.className="token";t.style.background=p.color;t.title=p.name;ts.appendChild(t)}});b.appendChild(e)}}
function ocol(id){return state.players.find(p=>p.id===id)?.color||"#777"}function esc(x){return String(x).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
function show(title,body,buttons){$("mtitle").textContent=title;$("mbody").innerHTML=body;$("mact").innerHTML="";buttons.forEach(x=>{let b=document.createElement("button");b.textContent=x.t;b.className=x.c||"";b.onclick=()=>{x.f();closeM()};$("mact").appendChild(b)});$("modal").classList.remove("hide")}
function closeM(){$("modal").classList.add("hide")}
function buyModal(){const c=state.board[me().pos];show("Купить собственность?",`<p>${esc(c.name)} — <b>$${c.price}</b></p><p class="small">Можно купить самому или запустить аукцион.</p>`,[{t:"Купить",f:()=>socket.emit("buy"),c:"green"},{t:"Аукцион",f:()=>socket.emit("auction")},{t:"Отмена",f:()=>{}}])}
function auctionModal(){if(!state.auction)return;const a=state.auction,c=state.board[a.cellId],turn=state.players[a.turnIndex];show("Аукцион: "+c.name,`<p>Текущая ставка: <b>$${a.currentBid}</b></p><p>Сейчас ходит: <b>${esc(turn?.name||"—")}</b></p>${turn?.id===myId?`<input id="bid" type="number" min="${a.currentBid+1}" value="${a.currentBid+10}" style="width:150px">`:""} `,turn?.id===myId?[{t:"Сделать ставку",c:"green",f:()=>socket.emit("bid",{amount:+$("bid").value})},{t:"Пас",f:()=>socket.emit("passAuction")}]:[{t:"Закрыть",f:()=>{}}])}
function tradeModal(incoming){if(incoming){const t=state.trade,from=state.players.find(p=>p.id===t.fromId);show("Предложение обмена",`<p>${esc(from?.name)} предлагает $${t.offerMoney} и собственность №${t.offerCell??"—"} в обмен на $${t.requestMoney} и собственность №${t.requestCell??"—"}.</p>`,[{t:"Принять",c:"green",f:()=>socket.emit("tradeAccept")},{t:"Отклонить",c:"red",f:()=>socket.emit("tradeReject")}]);return}
const others=state.players.filter(p=>p.id!==myId&&!p.bankrupt);if(!others.length)return alert("Нет игроков для обмена.");
const props=state.board.map((c,i)=>c.owner===myId?`<option value="${i}">${esc(c.name)}</option>`:"").join("");
const wanted=state.board.map((c,i)=>c.owner!==myId&&c.owner?`<option value="${i}">${esc(c.name)}</option>`:"").join("");
show("Предложить обмен",`<div class="tradegrid"><div><label>Кому</label><select id="to">${others.map(p=>`<option value="${p.id}">${esc(p.name)}</option>`).join("")}</select></div><div><label>Мои деньги</label><input id="om" type="number" value="0" min="0"></div><div><label>Моя собственность</label><select id="oc"><option value="">Нет</option>${props}</select></div><div><label>Его деньги</label><input id="rm" type="number" value="0" min="0"></div><div><label>Его собственность</label><select id="rc"><option value="">Нет</option>${wanted}</select></div></div>`,[{t:"Отправить",c:"green",f:()=>socket.emit("tradeOffer",{toId:$("to").value,offerMoney:+$("om").value,requestMoney:+$("rm").value,offerCell:$("oc").value===""?null:+$("oc").value,requestCell:$("rc").value===""?null:+$("rc").value})},{t:"Отмена",f:()=>{}}])}
</script></body></html>
